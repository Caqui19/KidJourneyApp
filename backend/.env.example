NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kidjourney
DB_USER=seu_usuario_mysql
DB_PASSWORD=defina_uma_senha_forte
DB_SSL=false

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_use_uma_chave_aleatoria_com_pelo_menos_32_bytes

# Em produção, liste as origens web separadas por vírgula. Clientes nativos não enviam Origin.
CORS_ORIGINS=
# Use 1 apenas se a API receber tráfego por exatamente um proxy confiável.
TRUST_PROXY_HOPS=0
