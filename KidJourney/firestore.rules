rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        match /usuarios/{uid} {
            allow read: if request.auth != null && request.auth.uid == uid;

            allow create: if request.auth != null
                && request.auth.uid == uid
                && request.resource.data.keys().hasOnly([
                    'nome',
                    'email',
                    'termosUsoAceito',
                    'termosServicoAceito',
                    'politicaPrivacidadeAceita',
                    'aceitoEm'
                ])
                && request.resource.data.keys().hasAll([
                    'nome',
                    'email',
                    'termosUsoAceito',
                    'termosServicoAceito',
                    'politicaPrivacidadeAceita',
                    'aceitoEm'
                ])
                && request.resource.data.nome is string
                && request.resource.data.email == request.auth.token.email
                && request.resource.data.termosUsoAceito == true
                && request.resource.data.termosServicoAceito == true
                && request.resource.data.politicaPrivacidadeAceita == true
                && request.resource.data.aceitoEm == request.time;

            allow update, delete: if false;
        }
    }
}