{
  "expo": {
    "name": "KidJourney",
    "slug": "KidJourney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/appIcon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kidjourney.app",
      "adaptiveIcon": {
        "backgroundColor": "#C7E56D",
        "foregroundImage": "./src/assets/appIcon.png"
      }
    },
    "web": {
      "favicon": "./src/assets/appIcon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "4fc83d79-ea3e-4935-9bd8-af8964065fcb"
      }
    }
  }
}
